{
  "name": "tradeflow-core",
  "version": "1.0.0",
  "private": true,
  "description": "a lightweight tradeflow system core",
  "scripts": {
    "build": "uv run build.py",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "cd backend && pnpm dev",
    "dev:frontend": "cd frontend && pnpm dev",
    "format": "prettier --write .",
    "install:all": "pnpm install && cd frontend && pnpm install && cd ../backend && pnpm install && pnpm prisma generate",
    "preinstall": "npx only-allow pnpm",
    "start": "cd dist && node backend/server.js",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:setup": "node scripts/test-setup.mjs"
  }
}
