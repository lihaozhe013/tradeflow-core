{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "bun ./scripts/bundle.ts",
    "prisma:generate": "prisma generate --no-hints && bun ./scripts/generateSchemaManifest.ts",
    "dev": "bun run prisma:generate && bun --watch server.ts",
    "dev:debug": "bun run prisma:generate && bun --inspect --watch server.ts",
    "dev:reset": "bun run prisma:generate && bun scripts/seedDevDatabase.ts && bun --watch server.ts",
    "db:reset": "bun run prisma:generate && bun scripts/seedDevDatabase.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:seed": "bun test/seedRunner.ts",
    "test:db:setup": "bun test/setupE2eDatabase.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "^7.10.1",
    "@types/js-yaml": "^4.0.9",
    "argon2": "^0.45.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "fs-extra": "^11.4.1",
    "hono": "^4.13.16",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/bun": "^1.4.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "nodemon": "^3.1.14",
    "oxlint": "^1.89.0",
    "pgsql-ast-parser": "12.0.2",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.8",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {}
}
