{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "node ./scripts/bundle.mjs",
    "prisma:generate": "prisma generate --no-hints && bun ./scripts/generateSchemaManifest.ts",
    "dev": "bun run prisma:generate && tsx watch server.ts",
    "dev:debug": "bun run prisma:generate && tsx watch --inspect server.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:seed": "tsx test/seedRunner.ts",
    "test:db:setup": "tsx test/setupE2eDatabase.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "^7.10.1",
    "@types/js-yaml": "^4.0.9",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "fs-extra": "^11.4.1",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/superagent": "^8.1.11",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "esbuild-plugin-tsconfig-paths": "^1.0.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "pgsql-ast-parser": "12.0.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.8",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {}
}
