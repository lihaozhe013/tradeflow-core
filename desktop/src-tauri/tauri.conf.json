{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradeFlow Connect (Test)",
  "version": "0.1.1",
  "identifier": "com.tradeflow.connect",
  "build": {
    "beforeDevCommand": "bun run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TradeFlow Connect",
        "width": 960,
        "height": 760,
        "minWidth": 720,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "deb", "appimage"],
    "externalBin": ["binaries/tradeflow-connect"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
